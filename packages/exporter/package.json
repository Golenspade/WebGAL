{
  "name": "webgal-exporter",
  "version": "0.1.0",
  "description": "WebGAL video exporter - convert game scenes to .mov videos",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "webgal-export": "./build/cli/index.js"
  },
  "scripts": {
    "build": "rimraf build && tsc",
    "dev": "tsc --watch",
    "export": "node --loader tsx ./src/cli/index.ts"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "fluent-ffmpeg": "^2.1.2",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "webgal-parser": "*"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "author": "WebGAL Contributors",
  "license": "MPL-2.0"
}
